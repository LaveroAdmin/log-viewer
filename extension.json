{
    "name": "laveroadmin/log-viewer",
    "title": {
        "en": "Log Viewer",
        "ru": "Просмотр логов"
    },
    "description": {
        "en": "Real-time viewer for Laravel log files with level filters, search, and download.",
        "ru": "Просмотр журналов логов Laravel в реальном времени с фильтрацией по уровням и поиском."
    },
    "category": "system",
    "icon": "icon-database",
    "version": "1.0.0",
    "author": {
        "name": "Aleksandr Kireev",
        "email": "hello@bespredel.name",
        "url": "https://bespredel.name"
    },
    "github": "https://github.com/LaveroAdmin/log-viewer",
    "setup": {
        "commands": [
            {
                "cmd": "php artisan admin:import log-viewer",
                "desc": {
                    "en": "Import log viewer menu item",
                    "ru": "Импорт пункта меню журнала логов"
                }
            }
        ],
        "config": {
            "file": "config/admin.php",
            "code": "'log-viewer' => [\n    'enable' => true,\n],"
        },
        "requirements": {
            "en": [
                "PHP >= 8.1"
            ],
            "ru": [
                "PHP >= 8.1"
            ]
        },
        "notes": {
            "en": [
                "Reads log files from storage/logs/*.log."
            ],
            "ru": [
                "Читает файлы из папки storage/logs/*.log."
            ]
        }
    },
    "key": "log-viewer",
    "compatibility": {
        "php": ">=8.1",
        "laravel": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "admin": "^1.0",
        "extensions": [
            "pdo"
        ]
    }
}
