{
    "name": "laveroadmin/log-viewer",
    "description": "Log viewer for LaveroAdmin",
    "type": "library",
    "keywords": [
        "lavero-admin",
        "log",
        "viewer"
    ],
    "homepage": "https://bespredel.name",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksandr Kireev",
            "email": "hello@bespredel.name",
            "homepage": "https://bespredel.name"
        }
    ],
    "require": {
        "php": ">=7.3",
        "laveroadmin/laveroadmin": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "~6.0"
    },
    "autoload": {
        "psr-4": {
            "LaveroAdmin\\Admin\\LogViewer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaveroAdmin\\Admin\\LogViewer\\LogViewerServiceProvider"
            ]
        }
    }
}
